[{"i": 0, "text": "\u5b9e\u9645\u8bc4\u4ef7\u65b9\u6848", "style": "Heading 2"}, {"i": 1, "text": "", "style": "Normal"}, {"i": 2, "text": "\u8bc4\u4ef7\u53e3\u5f84\u8bf4\u660e", "style": "Heading 2"}, {"i": 3, "text": "\u56e2\u961f\u91cd\u70b9\u8bc4\u4ef7\u7684\u662f\u54ea\u4e9b\u65b9\u9762\uff0c\u4e3a\u4ec0\u4e48\uff1a_______________________________________________", "style": "List Bullet"}, {"i": 4, "text": "\u8bc4\u4ef7\u7531\u7a0b\u5e8f\u3001\u6a21\u578b\u3001\u56e2\u961f\u6210\u5458\u6216\u9886\u57df\u4e13\u5bb6\u4e2d\u7684\u54ea\u4e9b\u4e3b\u4f53\u5b8c\u6210\uff1a_________________________", "style": "List Bullet"}, {"i": 5, "text": "\u7b2c\u4e00\u8f6e\u4e0e\u7b2c\u4e8c\u8f6e\u662f\u5426\u91c7\u7528\u540c\u4e00\u53e3\u5f84\uff1b\u5982\u6709\u53d8\u5316\uff0c\u539f\u56e0\u662f\u4ec0\u4e48\uff1a_________________________", "style": "List Bullet"}, {"i": 6, "text": "\u4ec0\u4e48\u60c5\u51b5\u4e0b\u7ee7\u7eed\u751f\u6210\u3001\u505c\u6b62\u6216\u4ea4\u7531\u7814\u7a76\u8005\u5224\u65ad\uff1a_____________________________________", "style": "List Bullet"}, {"i": 7, "text": "P6\uff5c\u7cfb\u7edf\u603b\u4f53\u67b6\u6784\u4e0e\u6280\u672f\u95ed\u73af", "style": "Heading 1"}, {"i": 8, "text": "\u672c\u4f5c\u54c1\u771f\u5b9e\u67b6\u6784", "style": "Heading 2"}, {"i": 9, "text": "[\u8bf7\u63d2\u5165\u672c\u4f5c\u54c1\u5b9e\u9645\u67b6\u6784\u56fe\uff0c\u6807\u660e\u79d1\u5b66\u95ee\u9898\u3001\u8bc1\u636e\u3001\u5019\u9009\u5047\u8bbe\u3001\u7814\u7a76\u8ba1\u5212\u548c\u53cd\u9988\u5728\u7cfb\u7edf\u4e2d\u7684\u6d41\u52a8\u65b9\u5411\uff0c\u4ee5\u53caQwen\u3001\u5916\u90e8\u5de5\u5177\u548c\u4eba\u5de5\u53c2\u4e0e\u7684\u4f4d\u7f6e\u3002]", "style": "Normal"}, {"i": 10, "text": "", "style": "Normal"}, {"i": 11, "text": "\u6280\u672f\u95ed\u73af\u7684\u5173\u952e\u8bbe\u8ba1", "style": "Heading 2"}, {"i": 12, "text": "[\u8bf7\u8bf4\u660e\u672c\u4f5c\u54c1\u4e3a\u4ec0\u4e48\u4e0d\u662f\u4e00\u6b21\u6027\u95ee\u7b54\uff0c\u4ee5\u53ca\u54ea\u4e9b\u4e2d\u95f4\u7ed3\u679c\u4f1a\u8fdb\u5165\u4e0b\u4e00\u8f6e\u751f\u6210\u6216\u4fee\u8ba2\u3002]", "style": "Normal"}, {"i": 13, "text": "P7\uff5cQwen\u4f7f\u7528\u65b9\u5f0f\u4e0e\u4e0a\u4e0b\u6587\u5de5\u7a0b", "style": "Heading 1"}, {"i": 14, "text": "Qwen\u5728\u672c\u4f5c\u54c1\u4e2d\u7684\u5b9e\u9645\u4f5c\u7528", "style": "Heading 2"}, {"i": 15, "text": "", "style": "Normal"}, {"i": 16, "text": "\u4e0a\u4e0b\u6587\u7ec4\u7ec7", "style": "Heading 2"}, {"i": 17, "text": "[\u8bf7\u63d2\u5165\u4e00\u4efd\u771f\u5b9e\u7684\u4e0a\u4e0b\u6587\u7ed3\u6784\u793a\u610f\uff0c\u8bf4\u660e\u79d1\u5b66\u95ee\u9898\u3001\u5df2\u6709\u8bc1\u636e\u3001\u53cd\u5bf9\u8bc1\u636e\u3001\u5173\u952e\u7ea6\u675f\u3001\u5386\u53f2\u7ed3\u679c\u548c\u53cd\u9988\u4fe1\u606f\u5982\u4f55\u8fdb\u5165\u6a21\u578b\u3002]", "style": "Normal"}, {"i": 18, "text": "\u56e2\u961f\u4e3a\u51cf\u5c11\u65e0\u4f9d\u636e\u751f\u6210\u5b9e\u9645\u91c7\u53d6\u7684\u63aa\u65bd\uff1a___________________________________________", "style": "List Bullet"}, {"i": 19, "text": "\u4e0a\u4e0b\u6587\u66f4\u65b0\u6216\u591a\u8f6e\u8c03\u7528\u7684\u89e6\u53d1\u65b9\u5f0f\uff1a_______________________________________________", "style": "List Bullet"}, {"i": 20, "text": "\u8be5\u8bbe\u8ba1\u5bf9\u7ed3\u679c\u5e26\u6765\u7684\u5b9e\u9645\u53d8\u5316\uff1a___________________________________________________", "style": "List Bullet"}, {"i": 21, "text": "P8\uff5c\u79d1\u5b66\u95ee\u9898\u7406\u89e3\u4e0e\u77e5\u8bc6\u7f3a\u53e3\u8bc6\u522b\u65b9\u6cd5", "style": "Heading 1"}, {"i": 22, "text": "\u672c\u4f5c\u54c1\u5b9e\u9645\u5904\u7406\u8fc7\u7a0b", "style": "Heading 2"}, {"i": 23, "text": "", "style": "Normal"}, {"i": 24, "text": "\u4e00\u9879\u771f\u5b9e\u4e2d\u95f4\u7ed3\u679c\u793a\u4f8b", "style": "Heading 2"}, {"i": 25, "text": "[\u8bf7\u9009\u62e9\u4e00\u9053\u5b9e\u9645\u6d4b\u8bd5\u9898\uff0c\u5c55\u793a\u7cfb\u7edf\u89e3\u6790\u5f97\u5230\u7684\u7814\u7a76\u5bf9\u8c61\u3001\u5173\u952e\u53d8\u91cf\u3001\u5df2\u6709\u8ba4\u8bc6\u3001\u77e5\u8bc6\u7f3a\u53e3\u548c\u7ea6\u675f\u3002\u6b64\u5904\u53ea\u9700\u7b80\u4f8b\uff0c\u5b8c\u6574\u6848\u4f8b\u653e\u5728P14\u2014P17\u3002]", "style": "Normal"}, {"i": 26, "text": "________________________________________________________________________________", "style": "Normal"}, {"i": 27, "text": "P9\uff5c\u5019\u9009\u5047\u8bbe\u751f\u6210\u65b9\u6cd5", "style": "Heading 1"}, {"i": 28, "text": "\u672c\u4f5c\u54c1\u5b9e\u9645\u91c7\u7528\u7684\u751f\u6210\u673a\u5236", "style": "Heading 2"}, {"i": 29, "text": "", "style": "Normal"}, {"i": 30, "text": "\u5019\u9009\u5047\u8bbe\u7684\u5b9e\u9645\u8f93\u51fa\u5185\u5bb9", "style": "Heading 2"}, {"i": 31, "text": "[\u8bf7\u8bf4\u660e\u672c\u4f5c\u54c1\u6bcf\u6761\u5019\u9009\u5047\u8bbe\u771f\u5b9e\u5305\u542b\u54ea\u4e9b\u5185\u5bb9\uff0c\u4f8b\u5982\u6838\u5fc3\u9648\u8ff0\u3001\u5f62\u6210\u4f9d\u636e\u3001\u652f\u6301\u4e0e\u53cd\u5bf9\u8bc1\u636e\u3001\u53ef\u68c0\u9a8c\u9884\u6d4b\u3001\u66ff\u4ee3\u89e3\u91ca\u548c\u4e0d\u786e\u5b9a\u6027\u3002]", "style": "Normal"}, {"i": 32, "text": "________________________________________________________________________________", "style": "Normal"}, {"i": 33, "text": "P10\uff5c\u5019\u9009\u5047\u8bbe\u6838\u9a8c\u3001\u6bd4\u8f83\u4e0e\u7b5b\u9009\u65b9\u6cd5", "style": "Heading 1"}, {"i": 34, "text": "\u672c\u4f5c\u54c1\u5b9e\u9645\u91c7\u7528\u7684\u5904\u7406\u65b9\u6cd5", "style": "Heading 2"}, {"i": 35, "text": "", "style": "Normal"}, {"i": 36, "text": "\u7b5b\u9009\u7ed3\u679c\u5982\u4f55\u5f62\u6210", "style": "Heading 2"}, {"i": 37, "text": "[\u8bf7\u8bf4\u660e\u56e2\u961f\u5b9e\u9645\u5982\u4f55\u4fdd\u7559\u3001\u5408\u5e76\u3001\u964d\u7ea7\u6216\u6dd8\u6c70\u5019\u9009\u5047\u8bbe\uff0c\u5e76\u7528\u4e00\u4e2a\u7b80\u77ed\u4f8b\u5b50\u8bf4\u660e\u4e3a\u4ec0\u4e48\u9009\u62e9\u67d0\u4e00\u5047\u8bbe\u800c\u6ca1\u6709\u9009\u62e9\u53e6\u4e00\u5047\u8bbe\u3002]", "style": "Normal"}, {"i": 38, "text": "________________________________________________________________________________", "style": "Normal"}, {"i": 39, "text": "P11\uff5c\u7814\u7a76\u8ba1\u5212\u751f\u6210\u4e0e\u5047\u8bbe\u9a8c\u8bc1\u8def\u5f84", "style": "Heading 1"}, {"i": 40, "text": "\u672c\u4f5c\u54c1\u5982\u4f55\u628a\u5047\u8bbe\u8f6c\u5316\u4e3a\u7814\u7a76\u8ba1\u5212", "style": "Heading 2"}, {"i": 41, "text": "", "style": "Normal"}, {"i": 42, "text": "\u53ef\u6267\u884c\u6027", "style": "Heading 2"}, {"i": 43, "text": "\u56e2\u961f\u5982\u4f55\u68c0\u67e5\u7814\u7a76\u8ba1\u5212\u662f\u5426\u5177\u4f53\u3001\u53ef\u590d\u6838\uff1a_________________________________________", "style": "List Bullet"}, {"i": 44, "text": "\u7814\u7a76\u8ba1\u5212\u4e2d\u54ea\u4e9b\u5185\u5bb9\u5df2\u7ecf\u5177\u5907\u6267\u884c\u6761\u4ef6\uff0c\u54ea\u4e9b\u4ecd\u662f\u5efa\u8bae\uff1a_____________________________", "style": "List Bullet"}, {"i": 45, "text": "\u672c\u4f5c\u54c1\u5982\u4f55\u907f\u514d\u7528\u201c\u8fdb\u4e00\u6b65\u7814\u7a76\u201d\u7b49\u7a7a\u6cdb\u8868\u8ff0\u4ee3\u66ff\u7814\u7a76\u6b65\u9aa4\uff1a_________________________", "style": "List Bullet"}, {"i": 46, "text": "P12\uff5c\u5b8c\u6574\u8fd0\u884c\u6d41\u7a0b\u4e0e\u5b9e\u9645\u53cd\u9988\u673a\u5236", "style": "Heading 1"}, {"i": 47, "text": "\u4e00\u6b21\u5b8c\u6574\u8fd0\u884c", "style": "Heading 2"}, {"i": 48, "text": "[\u8bf7\u63d2\u5165\u672c\u4f5c\u54c1\u771f\u5b9e\u5de5\u4f5c\u6d41\u7a0b\u56fe\uff0c\u5c55\u793a\u4ece\u63a5\u6536\u4e00\u9053\u79d1\u5b66\u95ee\u9898\u5230\u5f62\u6210\u5019\u9009\u5047\u8bbe\u548c\u7814\u7a76\u8ba1\u5212\u7684\u5168\u8fc7\u7a0b\uff0c\u5e76\u6807\u660e\u53cd\u9988\u8fd4\u56de\u5230\u54ea\u4e2a\u73af\u8282\u3002]", "style": "Normal"}, {"i": 49, "text": "\u672c\u4f5c\u54c1\u5b9e\u9645\u5b9e\u73b0\u7684\u53cd\u9988\u4e0e\u5931\u8d25\u5904\u7406", "style": "Heading 2"}, {"i": 50, "text": "", "style": "Normal"}, {"i": 51, "text": "\u54ea\u4e9b\u53cd\u9988\u7531\u7cfb\u7edf\u81ea\u52a8\u4ea7\u751f\uff1a_________________________________________________________", "style": "List Bullet"}, {"i": 52, "text": "\u54ea\u4e9b\u8c03\u6574\u6765\u81ea\u7814\u7a76\u8005\u6216\u56e2\u961f\u6210\u5458\uff1a_________________________________________________", "style": "List Bullet"}, {"i": 53, "text": "\u56e2\u961f\u5b9e\u9645\u4fdd\u7559\u4e86\u54ea\u4e9b\u524d\u540e\u53d8\u5316\uff0c\u4fbf\u4e8e\u8bf4\u660e\u53cd\u9988\u662f\u5426\u6709\u6548\uff1a_____________________________", "style": "List Bullet"}, {"i": 54, "text": "P13\uff5c125\u9898\u6d4b\u8bd5\u65b9\u6cd5\u4e0e\u4ee3\u8868\u6027\u6848\u4f8b\u9009\u62e9", "style": "Heading 1"}, {"i": 55, "text": "125\u9898\u5b9e\u9645\u6d4b\u8bd5\u65b9\u6cd5", "style": "Heading 2"}, {"i": 56, "text": "[\u8bf7\u8bf4\u660e\u672c\u4f5c\u54c1\u5982\u4f55\u5bf9\u5b98\u65b9125\u9053\u79d1\u5b66\u95ee\u9898\u8fdb\u884c\u5168\u91cf\u6d4b\u8bd5\uff0c\u5305\u62ec\u5355\u9898\u8fd0\u884c\u65b9\u5f0f\u3001\u5171\u540c\u8f93\u51fa\u5185\u5bb9\u3001\u603b\u4f53\u8bc4\u4ef7\u65b9\u6cd5\uff0c\u4ee5\u53ca\u8bc1\u636e\u4e0d\u8db3\u3001\u5931\u8d25\u6216\u9700\u4eba\u5de5\u5224\u65ad\u7684\u9898\u76ee\u5982\u4f55\u4fdd\u7559\u3002]", "style": "Normal"}, {"i": 57, "text": "________________________________________________________________________________", "style": "Normal"}, {"i": 58, "text": "\u4ee3\u8868\u6027\u6848\u4f8b\u4e3a\u4ec0\u4e48\u9009\u62e9\u8fd9\u9053\u9898", "style": "Heading 2"}, {"i": 59, "text": "\u6848\u4f8b\u6240\u5c5e\u7684\u79d1\u5b66\u9886\u57df\u53ca\u95ee\u9898\u7279\u70b9\uff1a_________________________________________________", "style": "List Bullet"}, {"i": 60, "text": "\u56e2\u961f\u9009\u62e9\u5b83\u8fdb\u884c\u5b8c\u6574\u5c55\u793a\u7684\u5b9e\u9645\u7406\u7531\uff1a_____________________________________________", "style": "List Bullet"}, {"i": 61, "text": "\u8be5\u6848\u4f8b\u80fd\u591f\u5c55\u793a\u672c\u4f5c\u54c1\u7684\u54ea\u4e9b\u5173\u952e\u80fd\u529b\uff1a___________________________________________", "style": "List Bullet"}, {"i": 62, "text": "\u8be5\u6848\u4f8b\u8868\u73b0\u4e0d\u80fd\u4ee3\u8868\u54ea\u4e9b\u9898\u76ee\u6216\u6761\u4ef6\uff1a_____________________________________________", "style": "List Bullet"}, {"i": 63, "text": "P14\uff5c\u6848\u4f8b\u95ee\u9898\u3001\u8bc1\u636e\u57fa\u7840\u4e0e\u7b2c\u4e00\u8f6e\u8bbe\u7f6e", "style": "Heading 1"}, {"i": 64, "text": "\u6848\u4f8b\u7684\u79d1\u5b66\u5185\u5bb9", "style": "Heading 2"}, {"i": 65, "text": "", "style": "Normal"}, {"i": 66, "text": "\u7b2c\u4e00\u8f6e\u5b9e\u9645\u751f\u6210\u8bbe\u7f6e", "style": "Heading 2"}, {"i": 67, "text": "\u7b2c\u4e00\u8f6e\u4f7f\u7528\u4e86\u54ea\u4e9b\u8bc1\u636e\u548c\u7ea6\u675f\uff1a___________________________________________________", "style": "List Bullet"}, {"i": 68, "text": "\u7b2c\u4e00\u8f6e\u8981\u6c42\u7cfb\u7edf\u751f\u6210\u4ec0\u4e48\u5185\u5bb9\uff1a___________________________________________________", "style": "List Bullet"}, {"i": 69, "text": "\u7b2c\u4e00\u8f6e\u91c7\u7528\u4e86\u54ea\u4e9b\u4e3b\u8981\u6a21\u578b\u6216\u65b9\u6cd5\u8bbe\u7f6e\uff1a___________________________________________", "style": "List Bullet"}, {"i": 70, "text": "\u7b2c\u4e00\u8f6e\u7ed3\u679c\u4f7f\u7528\u4ec0\u4e48\u53e3\u5f84\u8bc4\u4ef7\uff1a___________________________________________________", "style": "List Bullet"}, {"i": 71, "text": "P15\uff5c\u7b2c\u4e00\u8f6e\u5019\u9009\u5047\u8bbe\u3001\u7b5b\u9009\u7ed3\u679c\u4e0e\u7814\u7a76\u8ba1\u5212", "style": "Heading 1"}, {"i": 72, "text": "\u7b2c\u4e00\u8f6e\u5b9e\u9645\u751f\u6210\u7ed3\u679c", "style": "Heading 2"}, {"i": 73, "text": "", "style": "Normal"}, {"i": 74, "text": "\u7b2c\u4e00\u8f6e\u5f62\u6210\u7684\u7814\u7a76\u8ba1\u5212", "style": "Heading 2"}, {"i": 75, "text": "", "style": "Normal"}, {"i": 76, "text": "P16\uff5c\u7b2c\u4e00\u8f6e\u95ee\u9898\u5206\u6790\u4e0e\u8c03\u6574\u4f9d\u636e", "style": "Heading 1"}, {"i": 77, "text": "\u56e2\u961f\u5b9e\u9645\u53d1\u73b0\u7684\u95ee\u9898", "style": "Heading 2"}, {"i": 78, "text": "", "style": "Normal"}, {"i": 79, "text": "\u8c03\u6574\u903b\u8f91", "style": "Heading 2"}, {"i": 80, "text": "\u54ea\u6761\u8bc1\u636e\u3001\u8bc4\u4ef7\u6216\u4eba\u5de5\u610f\u89c1\u89e6\u53d1\u4e86\u8c03\u6574\uff1a___________________________________________", "style": "List Bullet"}, {"i": 81, "text": "\u7b2c\u4e8c\u8f6e\u589e\u52a0\u3001\u5220\u9664\u6216\u6539\u53d8\u4e86\u4ec0\u4e48\uff1a_________________________________________________", "style": "List Bullet"}, {"i": 82, "text": "\u54ea\u4e9b\u5185\u5bb9\u4fdd\u6301\u4e0d\u53d8\uff0c\u4e3a\u4ec0\u4e48\uff1a_____________________________________________________", "style": "List Bullet"}, {"i": 83, "text": "\u56e2\u961f\u9884\u671f\u7b2c\u4e8c\u8f6e\u5728\u54ea\u4e9b\u65b9\u9762\u6539\u5584\uff1a_________________________________________________", "style": "List Bullet"}, {"i": 84, "text": "P17\uff5c\u7b2c\u4e8c\u8f6e\u5019\u9009\u5047\u8bbe\u3001\u7814\u7a76\u8ba1\u5212\u4e0e\u4fee\u8ba2\u7ed3\u679c", "style": "Heading 1"}, {"i": 85, "text": "\u7b2c\u4e00\u8f6e\u4e0e\u7b2c\u4e8c\u8f6e\u7684\u5b9e\u9645\u53d8\u5316", "style": "Heading 2"}, {"i": 86, "text": "", "style": "Normal"}, {"i": 87, "text": "\u7b2c\u4e8c\u8f6e\u7ed3\u8bba", "style": "Heading 2"}, {"i": 88, "text": "\u7b2c\u4e8c\u8f6e\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________________________", "style": "List Bullet"}, {"i": 89, "text": "\u54ea\u4e9b\u65b9\u9762\u6ca1\u6709\u6539\u5584\u6216\u51fa\u73b0\u4e86\u65b0\u7684\u4ee3\u4ef7\uff1a_____________________________________________", "style": "List Bullet"}, {"i": 90, "text": "\u56e2\u961f\u4e3a\u4ec0\u4e48\u5728\u6b64\u65f6\u505c\u6b62\uff0c\u6216\u4e3a\u4ec0\u4e48\u4ecd\u9700\u7ee7\u7eed\u8fed\u4ee3\uff1a___________________________________", "style": "List Bullet"}, {"i": 91, "text": "P18\uff5c\u5b9e\u9645\u5bf9\u7167\u3001\u6d88\u878d\u4e0e\u65b9\u6848\u4f18\u52bf", "style": "Heading 1"}, {"i": 92, "text": "\u56e2\u961f\u5b9e\u9645\u5b8c\u6210\u7684\u6bd4\u8f83", "style": "Heading 2"}, {"i": 93, "text": "", "style": "Normal"}, {"i": 94, "text": "\u7ed3\u679c\u8bf4\u660e", "style": "Heading 2"}, {"i": 95, "text": "\u79d1\u5b66\u903b\u8f91\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "style": "List Bullet"}, {"i": 96, "text": "\u6280\u672f\u65b9\u6cd5\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "style": "List Bullet"}, {"i": 97, "text": "\u7ed3\u679c\u8868\u73b0\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "style": "List Bullet"}, {"i": 98, "text": "\u6ca1\u6709\u6539\u5584\u7684\u90e8\u5206\u53ca\u589e\u52a0\u7684\u6210\u672c\uff1a___________________________________________________", "style": "List Bullet"}, {"i": 99, "text": "P19\uff5c125\u9898\u603b\u4f53\u7ed3\u679c\u3001\u5931\u8d25\u5206\u6790\u4e0e\u9002\u7528\u8fb9\u754c", "style": "Heading 1"}, {"i": 100, "text": "125\u9898\u5b9e\u9645\u7ed3\u679c", "style": "Heading 2"}, {"i": 101, "text": "", "style": "Normal"}, {"i": 102, "text": "\u5931\u8d25\u4e0e\u8fb9\u754c", "style": "Heading 2"}, {"i": 103, "text": "", "style": "Normal"}, {"i": 104, "text": "\u5982\u56e2\u961f\u5b9e\u9645\u5f00\u5c55\u4e86125\u9898\u4e4b\u5916\u7684\u6cdb\u5316\u6d4b\u8bd5\uff0c\u53ef\u5728\u6b64\u8865\u5145\u9898\u76ee\u6765\u6e90\u3001\u6d4b\u8bd5\u65b9\u6cd5\u548c\u7ed3\u679c\uff1b\u672a\u5f00\u5c55\u5219\u4e0d\u5fc5\u8bbe\u7f6e\u8be5\u90e8\u5206\u3002", "style": "List Bullet"}, {"i": 105, "text": "\u8bf7\u660e\u786e\u5019\u9009\u5047\u8bbe\u548c\u7814\u7a76\u8ba1\u5212\u4ecd\u9700\u7814\u7a76\u8005\u5ba1\u67e5\uff0c\u4e0d\u80fd\u7b49\u540c\u4e8e\u5df2\u7ecf\u83b7\u5f97\u79d1\u5b66\u53d1\u73b0\u6216\u5b8c\u6210\u771f\u5b9e\u9a8c\u8bc1\u3002", "style": "List Bullet"}, {"i": 106, "text": "P20\uff5c\u4ee3\u7801\u590d\u73b0\u4e0e\u63d0\u4ea4\u6750\u6599", "style": "Heading 1"}, {"i": 107, "text": "\u6700\u7ec8\u4ea4\u4ed8\u5185\u5bb9", "style": "Heading 2"}, {"i": 108, "text": "", "style": "Normal"}, {"i": 109, "text": "\u63d0\u4ea4\u524d\u81ea\u68c0", "style": "Heading 2"}, {"i": 110, "text": "\u25a1 \u6280\u672f\u65b9\u6848PPT/PDF\u4e0d\u8d85\u8fc720\u9875\uff0c\u6b63\u6587\u5185\u5bb9\u4e0e\u672c\u4f5c\u54c1\u5b9e\u9645\u5b9e\u73b0\u4e00\u81f4\u3002", "style": "List Bullet"}, {"i": 111, "text": "\u25a1 \u5b98\u65b9125\u9053\u79d1\u5b66\u95ee\u9898\u5747\u4fdd\u7559\u9010\u9898\u8f93\u51fa\uff0c\u8bc1\u636e\u4e0d\u8db3\u3001\u5931\u8d25\u6216\u9700\u4eba\u5de5\u5224\u65ad\u7684\u9898\u76ee\u6ca1\u6709\u88ab\u7701\u7565\u3002", "style": "List Bullet"}, {"i": 112, "text": "\u25a1 \u4ee3\u8868\u6848\u4f8b\u771f\u5b9e\u5448\u73b0\u7b2c\u4e00\u8f6e\u7ed3\u679c\u3001\u8c03\u6574\u4f9d\u636e\u548c\u7b2c\u4e8c\u8f6e\u53d8\u5316\uff0c\u6ca1\u6709\u7528\u4e2a\u522b\u6848\u4f8b\u4ee3\u66ff\u603b\u4f53\u7ed3\u679c\u3002", "style": "List Bullet"}, {"i": 113, "text": "\u25a1 \u6e90\u7801\u3001\u8fd0\u884c\u8bf4\u660e\u3001Qwen\u8c03\u7528\u51ed\u8bc1\u3001125\u9898\u7ed3\u679c\u6587\u6863\u3001\u6d4b\u8bd5API\u548c\u524d\u7aef\u5165\u53e3\u53ef\u4ee5\u6b63\u5e38\u6838\u9a8c\u3002", "style": "List Bullet"}, {"i": 114, "text": "\u25a1 \u672a\u5c06\u6a21\u578b\u751f\u6210\u7684\u5019\u9009\u5047\u8bbe\u8868\u8ff0\u4e3a\u5df2\u7ecf\u5f97\u5230\u9a8c\u8bc1\u7684\u79d1\u5b66\u7ed3\u8bba\uff1b\u53d7\u9650\u6570\u636e\u3001\u5bc6\u94a5\u548c\u4e2a\u4eba\u4fe1\u606f\u5df2\u59a5\u5584\u5904\u7406\u3002", "style": "List Bullet"}, {"i": 115, "text": "", "style": "List Bullet"}]
