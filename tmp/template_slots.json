______________________________", "List Bullet"], [126, "\u7b2c\u4e8c\u8f6e\u589e\u52a0\u3001\u5220\u9664\u6216\u6539\u53d8\u4e86\u4ec0\u4e48\uff1a_________________________________________________", "List Bullet"], [127, "\u54ea\u4e9b\u5185\u5bb9\u4fdd\u6301\u4e0d\u53d8\uff0c\u4e3a\u4ec0\u4e48\uff1a_____________________________________________________", "List Bullet"], [128, "\u56e2\u961f\u9884\u671f\u7b2c\u4e8c\u8f6e\u5728\u54ea\u4e9b\u65b9\u9762\u6539\u5584\uff1a_________________________________________________", "List Bullet"], [131, "", "Normal"], [133, "\u7b2c\u4e8c\u8f6e\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________________________", "List Bullet"], [134, "\u54ea\u4e9b\u65b9\u9762\u6ca1\u6709\u6539\u5584\u6216\u51fa\u73b0\u4e86\u65b0\u7684\u4ee3\u4ef7\uff1a_____________________________________________", "List Bullet"], [135, "\u56e2\u961f\u4e3a\u4ec0\u4e48\u5728\u6b64\u65f6\u505c\u6b62\uff0c\u6216\u4e3a\u4ec0\u4e48\u4ecd\u9700\u7ee7\u7eed\u8fed\u4ee3\uff1a___________________________________", "List Bullet"], [138, "", "Normal"], [140, "\u79d1\u5b66\u903b\u8f91\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "List Bullet"], [141, "\u6280\u672f\u65b9\u6cd5\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "List Bullet"], [142, "\u7ed3\u679c\u8868\u73b0\u65b9\u9762\uff0c\u672c\u4f5c\u54c1\u5b9e\u9645\u6539\u5584\u4e86\u4ec0\u4e48\uff1a___________________________________________", "List Bullet"], [143, "\u6ca1\u6709\u6539\u5584\u7684\u90e8\u5206\u53ca\u589e\u52a0\u7684\u6210\u672c\uff1a___________________________________________________", "List Bullet"], [146, "", "Normal"], [148, "", "Normal"], [149, "\u5982\u56e2\u961f\u5b9e\u9645\u5f00\u5c55\u4e86125\u9898\u4e4b\u5916\u7684\u6cdb\u5316\u6d4b\u8bd5\uff0c\u53ef\u5728\u6b64\u8865\u5145\u9898\u76ee\u6765\u6e90\u3001\u6d4b\u8bd5\u65b9\u6cd5\u548c\u7ed3\u679c\uff1b\u672a\u5f00\u5c55\u5219\u4e0d\u5fc5\u8bbe\u7f6e\u8be5\u90e8\u5206\u3002", "List Bullet"], [150, "\u8bf7\u660e\u786e\u5019\u9009\u5047\u8bbe\u548c\u7814\u7a76\u8ba1\u5212\u4ecd\u9700\u7814\u7a76\u8005\u5ba1\u67e5\uff0c\u4e0d\u80fd\u7b49\u540c\u4e8e\u5df2\u7ecf\u83b7\u5f97\u79d1\u5b66\u53d1\u73b0\u6216\u5b8c\u6210\u771f\u5b9e\u9a8c\u8bc1\u3002", "List Bullet"], [153, "", "Normal"], [155, "\u25a1 \u6280\u672f\u65b9\u6848PPT/PDF\u4e0d\u8d85\u8fc720\u9875\uff0c\u6b63\u6587\u5185\u5bb9\u4e0e\u672c\u4f5c\u54c1\u5b9e\u9645\u5b9e\u73b0\u4e00\u81f4\u3002", "List Bullet"], [156, "\u25a1 \u5b98\u65b9125\u9053\u79d1\u5b66\u95ee\u9898\u5747\u4fdd\u7559\u9010\u9898\u8f93\u51fa\uff0c\u8bc1\u636e\u4e0d\u8db3\u3001\u5931\u8d25\u6216\u9700\u4eba\u5de5\u5224\u65ad\u7684\u9898\u76ee\u6ca1\u6709\u88ab\u7701\u7565\u3002", "List Bullet"], [157, "\u25a1 \u4ee3\u8868\u6848\u4f8b\u771f\u5b9e\u5448\u73b0\u7b2c\u4e00\u8f6e\u7ed3\u679c\u3001\u8c03\u6574\u4f9d\u636e\u548c\u7b2c\u4e8c\u8f6e\u53d8\u5316\uff0c\u6ca1\u6709\u7528\u4e2a\u522b\u6848\u4f8b\u4ee3\u66ff\u603b\u4f53\u7ed3\u679c\u3002", "List Bullet"], [158, "\u25a1 \u6e90\u7801\u3001\u8fd0\u884c\u8bf4\u660e\u3001Qwen\u8c03\u7528\u51ed\u8bc1\u3001125\u9898\u7ed3\u679c\u6587\u6863\u3001\u6d4b\u8bd5API\u548c\u524d\u7aef\u5165\u53e3\u53ef\u4ee5\u6b63\u5e38\u6838\u9a8c\u3002", "List Bullet"], [159, "\u25a1 \u672a\u5c06\u6a21\u578b\u751f\u6210\u7684\u5019\u9009\u5047\u8bbe\u8868\u8ff0\u4e3a\u5df2\u7ecf\u5f97\u5230\u9a8c\u8bc1\u7684\u79d1\u5b66\u7ed3\u8bba\uff1b\u53d7\u9650\u6570\u636e\u3001\u5bc6\u94a5\u548c\u4e2a\u4eba\u4fe1\u606f\u5df2\u59a5\u5584\u5904\u7406\u3002", "List Bullet"], [160, "", "List Bullet"]]
