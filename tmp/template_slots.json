[[5, "", "Normal"], [7, "", "Normal"], [8, "", "Normal"], [10, "\u672c\u4f5c\u54c1\u9488\u5bf9\u7684\u5177\u4f53\u95ee\u9898\uff1a___________________________________________________________", "List Bullet"], [11, "\u672c\u4f5c\u54c1\u5b9e\u9645\u5b8c\u6210\u7684\u6838\u5fc3\u65b9\u6cd5\uff1a_______________________________________________________", "List Bullet"], [12, "\u6700\u6709\u4ee3\u8868\u6027\u7684\u7ed3\u679c1\uff08\u5bf9\u8c61\u3001\u53e3\u5f84\u3001\u7ed3\u679c\uff09\uff1a_________________________________________", "List Bullet"], [13, "\u6700\u6709\u4ee3\u8868\u6027\u7684\u7ed3\u679c2\uff08\u5bf9\u8c61\u3001\u53e3\u5f84\u3001\u7ed3\u679c\uff09\uff1a_________________________________________", "List Bullet"], [14, "\u76ee\u524d\u4ecd\u5b58\u5728\u7684\u4e3b\u8981\u5c40\u9650\uff1a___________________________________________________________", "List Bullet"], [16, "PPT/PDF\u4e0d\u8d85\u8fc730\u9875\uff1b\u63d0\u4ea4\u53ef\u8c03\u7528\u6d4b\u8bd5API\u548c\u53ef\u4ea4\u4e92\u524d\u7aef\u5165\u53e3\u3001\u4ee3\u8868\u6027\u6d4b\u8bd5\u6848\u4f8b\u3001\u8be6\u7ec6\u5e94\u7528\u6280\u672f\u62a5\u544a\u548c\u6e90\u7801\u3002", "List Bullet"], [17, "\u57fa\u5ea7\u6a21\u578b\u4f7f\u7528Qwen\u7cfb\u5217\uff0c\u5e76\u901a\u8fc7\u963f\u91cc\u4e91\u767e\u70bc\u6216\u5b98\u7f51\u63a8\u8350\u5de5\u5177\u8c03\u7528\uff0c\u63d0\u4f9b\u8c03\u7528\u51ed\u8bc1\u6216\u622a\u56fe\u3002", "List Bullet"], [18, "\u65b9\u5411A\u63d0\u4ea4\u667a\u80fd\u4f53\u6846\u67b6\u5728\u5168\u90e8125\u4e2a\u79d1\u5b66\u95ee\u9898\u4e0a\u7684\u8f93\u51fa\u7ed3\u679c\u6587\u6863\uff1b\u6f14\u793a\u89c6\u9891\u4e3a\u53ef\u9009\uff0c\u65f6\u957f\u4e0d\u8d85\u8fc710\u5206\u949f\u3002", "List Bullet"], [21, "[\u8bf7\u7528\u4e00\u6bb5\u8bdd\u8bf4\u660e\uff1a\u9762\u5bf9\u79d1\u5b66\u95ee\u9898\u65f6\uff0c\u73b0\u6709\u65b9\u6cd5\u5b58\u5728\u54ea\u4e9b\u5177\u4f53\u4e0d\u8db3\uff0c\u672c\u4f5c\u54c1\u5e0c\u671b\u89e3\u51b3\u5176\u4e2d\u54ea\u4e00\u9879\u6216\u54ea\u51e0\u9879\u3002\u4e0d\u8981\u91cd\u59